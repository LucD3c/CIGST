// Schema de datos de CIGST (CEMEVE). Convenciones aplicadas a todas las entidades
// de negocio: id UUID, timestamps de auditoria (createdAt/updatedAt) y soft delete
// (deletedAt) para no perder trazabilidad historica ante un borrado.
// Excepciones deliberadas:
// - Session no lleva soft delete -> un token de sesion revocado se elimina de
//   verdad (hard delete), no tiene sentido conservar credenciales muertas.
// - User se borra fisicamente cuando lo elimina un Administrador (a pedido
//   explicito del negocio): las referencias opcionales (tickets, bitacora)
//   quedan en SetNull, y las sesiones de ese usuario se borran en cascada.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Role {
  id        String   @id @default(uuid())
  name      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users User[]

  @@map("roles")
}

model User {
  id           String    @id @default(uuid())
  name         String
  username     String    @unique
  passwordHash String    @map("password_hash")
  roleId       String    @map("role_id")
  employeeId   String?   @unique @map("employee_id")
  status       String    @default("Activo")
  lastAccessAt DateTime? @map("last_access_at")
  loginCount   Int       @default(0) @map("login_count")
  changeLog    String?   @map("change_log")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")
  deletedAt    DateTime? @map("deleted_at")

  role     Role      @relation(fields: [roleId], references: [id])
  employee Employee? @relation(fields: [employeeId], references: [id], onDelete: SetNull)

  sessions        Session[]
  ticketsCreated  Ticket[]        @relation("TicketCreatedBy")
  ticketsAssigned Ticket[]        @relation("TicketTechnician")
  logbookEntries  LogbookEntry[]
  conversationsAsUserA Conversation[] @relation("ConversationUserA")
  conversationsAsUserB Conversation[] @relation("ConversationUserB")
  chatMessages         Message[]
  notifications        Notification[]
  chatGroupsCreated    ChatGroup[]       @relation("ChatGroupCreator")
  chatGroupMemberships ChatGroupMember[]
  attachmentsUploaded  Attachment[]

  @@index([roleId])
  @@index([employeeId])
  @@map("users")
}

// Historial de cambios administrativos (User.changeLog, Employee.changeLog,
// Equipment.changeLog): texto plano que el service antepone en cada edicion
// ("26/07/2026 21:14 — Sector: «A» → «B»"). Visible solo para quien puede
// ver la entidad; lo escribe unicamente el backend, nunca el cliente.

model Session {
  id        String    @id @default(uuid())
  tokenHash String    @unique @map("token_hash")
  userId    String    @map("user_id")
  userAgent String?   @map("user_agent")
  ipAddress String?   @map("ip_address")
  expiresAt DateTime  @map("expires_at")
  createdAt DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("sessions")
}

model Sector {
  id        String    @id @default(uuid())
  name      String    @unique
  status    String    @default("Activo")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  employees  Employee[]
  equipment  Equipment[]
  tickets    Ticket[]
  categories TicketCategory[]

  @@map("sectors")
}

// Categorias de ticket POR SECTOR: cada sector que recibe pedidos define las
// suyas ("Hardware" para Sistemas, "Arreglar"/"Modificacion" para
// Mantenimiento, etc.). El Ticket guarda el NOMBRE como texto (snapshot):
// borrar una categoria no rompe los tickets historicos que la usaron.
model TicketCategory {
  id        String   @id @default(uuid())
  sectorId  String   @map("sector_id")
  name      String
  createdAt DateTime @default(now()) @map("created_at")

  sector Sector @relation(fields: [sectorId], references: [id], onDelete: Cascade)

  @@unique([sectorId, name])
  @@index([sectorId])
  @@map("ticket_categories")
}

model Schedule {
  id        String    @id @default(uuid())
  name      String    @unique
  startTime String    @map("start_time")
  endTime   String    @map("end_time")
  status    String    @default("Activo")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  tickets Ticket[]

  @@map("schedules")
}

model Employee {
  id           String    @id @default(uuid())
  code         String    @unique
  name         String
  document     String?
  email        String?
  phone        String?
  extension    String?
  sectorId     String?   @map("sector_id")
  position     String?
  status       String    @default("Activo")
  workShift    String?   @map("work_shift")
  // Horario laboral estructurado (HH:MM). Con estos dos campos la plataforma
  // puede calcular sola si la persona esta dentro de su horario ahora mismo,
  // en vez de depender de un texto libre que nadie puede interpretar.
  // Si workEndTime es menor que workStartTime, el turno cruza la medianoche
  // (por ejemplo 22:00–06:00) y el calculo lo contempla.
  workStartTime String?  @map("work_start_time")
  workEndTime   String?  @map("work_end_time")
  schedule     String?
  replacementId String?  @map("replacement_id")
  notes        String?
  changeLog    String?   @map("change_log")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")
  deletedAt    DateTime? @map("deleted_at")

  sector      Sector?    @relation(fields: [sectorId], references: [id], onDelete: SetNull)
  replacement Employee?  @relation("EmployeeReplacement", fields: [replacementId], references: [id], onDelete: SetNull)
  replacementOf Employee[] @relation("EmployeeReplacement")

  user                User?
  ticketsAsAffected   Ticket[]        @relation("TicketAffected")
  ticketsAsRequester  Ticket[]        @relation("TicketRequester")

  @@index([replacementId])
  @@index([sectorId])
  @@map("employees")
}

model Equipment {
  id        String    @id @default(uuid())
  code      String    @unique
  type      String
  model     String?
  status    String    @default("Activo")
  sectorId  String?   @map("sector_id")
  // Antes "notes"/Observaciones: renombrado a Cambios — historial automatico
  // de ediciones del equipo (la migracion renombra la columna, no pierde datos).
  changeLog String?   @map("change_log")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  sector Sector? @relation(fields: [sectorId], references: [id], onDelete: SetNull)

  tickets        Ticket[]
  logbookEntries LogbookEntry[]

  @@index([sectorId])
  @@map("equipment")
}

model Ticket {
  id            String    @id @default(uuid())
  code          String    @unique
  title         String
  description   String?
  employeeId    String    @map("employee_id")
  requestedById String?   @map("requested_by_id")
  equipmentId   String?   @map("equipment_id")
  sectorId      String?   @map("sector_id")
  scheduleId    String?   @map("schedule_id")
  category      String    @default("General")
  technicianId  String?   @map("technician_id")
  status        String    @default("Nuevo")
  priority      String    @default("Media")
  solution      String?
  timeSpent     String?   @map("time_spent")
  createdById   String?   @map("created_by_id")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")
  deletedAt     DateTime? @map("deleted_at")

  employee    Employee   @relation("TicketAffected", fields: [employeeId], references: [id])
  requestedBy Employee?  @relation("TicketRequester", fields: [requestedById], references: [id], onDelete: SetNull)
  equipment   Equipment? @relation(fields: [equipmentId], references: [id], onDelete: SetNull)
  sector      Sector?    @relation(fields: [sectorId], references: [id], onDelete: SetNull)
  schedule    Schedule?  @relation(fields: [scheduleId], references: [id], onDelete: SetNull)
  technician  User?      @relation("TicketTechnician", fields: [technicianId], references: [id], onDelete: SetNull)
  createdBy   User?      @relation("TicketCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)

  logbookEntries LogbookEntry[]
  attachments    Attachment[]

  @@index([employeeId])
  @@index([requestedById])
  @@index([equipmentId])
  @@index([sectorId])
  @@index([scheduleId])
  @@index([technicianId])
  @@index([createdById])
  @@index([status])
  @@map("tickets")
}

// Chat interno 1 a 1. Sin tabla de "grupos" (fuera de alcance por ahora).
// Conversation se crea recien con el primer mensaje (ver chat.service.ts),
// asi lastMessageAt nunca es null y el listado se ordena sin casos especiales.
// El par de usuarios se guarda canonico (userAId < userBId alfabeticamente)
// para que nunca existan dos conversaciones para el mismo par.
// Sin deletedAt: este alcance no incluye borrar ni editar mensajes.
model Conversation {
  id            String   @id @default(uuid())
  userAId       String   @map("user_a_id")
  userBId       String   @map("user_b_id")
  lastMessageAt DateTime @default(now()) @map("last_message_at")
  createdAt     DateTime @default(now()) @map("created_at")

  userA    User      @relation("ConversationUserA", fields: [userAId], references: [id], onDelete: Cascade)
  userB    User      @relation("ConversationUserB", fields: [userBId], references: [id], onDelete: Cascade)
  messages Message[]

  @@unique([userAId, userBId])
  @@index([userAId])
  @@index([userBId])
  @@map("chat_conversations")
}

// Un mensaje pertenece a una conversacion 1 a 1 (conversationId) O a un
// grupo (groupId) — exactamente uno de los dos, garantizado por el service.
model Message {
  id             String    @id @default(uuid())
  conversationId String?   @map("conversation_id")
  groupId        String?   @map("group_id")
  senderId       String    @map("sender_id")
  body           String
  createdAt      DateTime  @default(now()) @map("created_at")
  readAt         DateTime? @map("read_at")

  conversation Conversation? @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  group        ChatGroup?    @relation(fields: [groupId], references: [id], onDelete: Cascade)
  sender       User          @relation(fields: [senderId], references: [id], onDelete: Cascade)
  attachments  Attachment[]

  @@index([conversationId, createdAt])
  @@index([groupId, createdAt])
  @@index([senderId])
  @@map("chat_messages")
}

// Grupos de chat: los crea el Administrador y elige quienes participan.
// En los grupos el "leido" es por miembro (lastReadAt), no por mensaje.
model ChatGroup {
  id          String   @id @default(uuid())
  name        String
  createdById String?  @map("created_by_id")
  createdAt   DateTime @default(now()) @map("created_at")
  lastMessageAt DateTime @default(now()) @map("last_message_at")

  createdBy User?             @relation("ChatGroupCreator", fields: [createdById], references: [id], onDelete: SetNull)
  members   ChatGroupMember[]
  messages  Message[]

  @@index([createdById])
  @@map("chat_groups")
}

model ChatGroupMember {
  id         String    @id @default(uuid())
  groupId    String    @map("group_id")
  userId     String    @map("user_id")
  lastReadAt DateTime? @map("last_read_at")
  createdAt  DateTime  @default(now()) @map("created_at")

  group ChatGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  user  User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([groupId, userId])
  @@index([userId])
  @@map("chat_group_members")
}

// Archivos adjuntos (imagenes, PDF, Excel) de tickets y mensajes de chat.
// El archivo fisico vive en el volumen de uploads con un nombre aleatorio
// (storedName); aca solo los metadatos. Un adjunto pertenece a un ticket O a
// un mensaje; recien subido esta "suelto" (ambos null) hasta que el ticket o
// mensaje que lo referencia se crea. Los sueltos viejos se limpian solos.
model Attachment {
  id           String   @id @default(uuid())
  storedName   String   @unique @map("stored_name")
  originalName String   @map("original_name")
  mimeType     String   @map("mime_type")
  size         Int
  ticketId     String?  @map("ticket_id")
  messageId    String?  @map("message_id")
  uploadedById String?  @map("uploaded_by_id")
  createdAt    DateTime @default(now()) @map("created_at")

  ticket     Ticket?  @relation(fields: [ticketId], references: [id], onDelete: SetNull)
  message    Message? @relation(fields: [messageId], references: [id], onDelete: SetNull)
  uploadedBy User?    @relation(fields: [uploadedById], references: [id], onDelete: SetNull)

  @@index([ticketId])
  @@index([messageId])
  @@index([uploadedById])
  @@map("attachments")
}

// Notificaciones internas (campanita): las genera el backend ante eventos
// (ticket nuevo, cambio de estado, asignacion, alta en un grupo) y llevan a
// un destino dentro de la plataforma (targetType + targetId).
model Notification {
  id         String    @id @default(uuid())
  userId     String    @map("user_id")
  title      String
  targetType String    @map("target_type")
  targetId   String?   @map("target_id")
  readAt     DateTime? @map("read_at")
  createdAt  DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([userId, readAt])
  @@map("notifications")
}

model LogbookEntry {
  id                String    @id @default(uuid())
  code              String    @unique
  title             String
  category          String
  detail            String?
  authorId          String?   @map("author_id")
  relatedTicketId   String?   @map("related_ticket_id")
  relatedEquipmentId String?  @map("related_equipment_id")
  occurredAt        DateTime  @default(now()) @map("occurred_at")
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")
  deletedAt         DateTime? @map("deleted_at")

  author          User?      @relation(fields: [authorId], references: [id], onDelete: SetNull)
  relatedTicket   Ticket?    @relation(fields: [relatedTicketId], references: [id], onDelete: SetNull)
  relatedEquipment Equipment? @relation(fields: [relatedEquipmentId], references: [id], onDelete: SetNull)

  @@index([authorId])
  @@index([relatedTicketId])
  @@index([relatedEquipmentId])
  @@map("logbook_entries")
}
