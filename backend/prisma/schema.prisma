// Schema de datos de CIGST (CEMEVE). Convenciones aplicadas a todas las entidades
// de negocio: id UUID, timestamps de auditoria (createdAt/updatedAt) y soft delete
// (deletedAt) para no perder trazabilidad historica ante un borrado.
// Excepciones deliberadas:
// - Session no lleva soft delete -> un token de sesion revocado se elimina de
//   verdad (hard delete), no tiene sentido conservar credenciales muertas.
// - User se borra fisicamente cuando lo elimina un Administrador (a pedido
//   explicito del negocio): las referencias opcionales (tickets, bitacora)
//   quedan en SetNull, y las sesiones de ese usuario se borran en cascada.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Role {
  id        String   @id @default(uuid())
  name      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users User[]

  @@map("roles")
}

model User {
  id           String    @id @default(uuid())
  name         String
  username     String    @unique
  passwordHash String    @map("password_hash")
  roleId       String    @map("role_id")
  employeeId   String?   @unique @map("employee_id")
  status       String    @default("Activo")
  lastAccessAt DateTime? @map("last_access_at")
  loginCount   Int       @default(0) @map("login_count")
  changeLog    String?   @map("change_log")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")
  deletedAt    DateTime? @map("deleted_at")

  role     Role      @relation(fields: [roleId], references: [id])
  employee Employee? @relation(fields: [employeeId], references: [id], onDelete: SetNull)

  sessions        Session[]
  ticketsCreated  Ticket[]        @relation("TicketCreatedBy")
  ticketsAssigned Ticket[]        @relation("TicketTechnician")
  logbookEntries  LogbookEntry[]
  conversationsAsUserA Conversation[] @relation("ConversationUserA")
  conversationsAsUserB Conversation[] @relation("ConversationUserB")
  chatMessages         Message[]
  notifications        Notification[]
  chatGroupsCreated    ChatGroup[]       @relation("ChatGroupCreator")
  chatGroupMemberships ChatGroupMember[]
  attachmentsUploaded  Attachment[]
  posts                Post[]         @relation("PostAuthor")
  postComments         PostComment[]  @relation("PostCommentAuthor")
  postReactions        PostReaction[] @relation("PostReactionUser")
  postViews            PostView[]     @relation("PostViewUser")
  kbSpacesCreated      KbSpace[]      @relation("KbSpaceCreator")
  kbArticlesEdited     KbArticle[]    @relation("KbArticleEditor")
  kbPermissions        KbPermission[] @relation("KbPermissionUser")

  @@index([roleId])
  @@index([employeeId])
  @@map("users")
}

// Historial de cambios administrativos (User.changeLog, Employee.changeLog,
// Equipment.changeLog): texto plano que el service antepone en cada edicion
// ("26/07/2026 21:14 — Sector: «A» → «B»"). Visible solo para quien puede
// ver la entidad; lo escribe unicamente el backend, nunca el cliente.

model Session {
  id        String    @id @default(uuid())
  tokenHash String    @unique @map("token_hash")
  userId    String    @map("user_id")
  userAgent String?   @map("user_agent")
  ipAddress String?   @map("ip_address")
  expiresAt DateTime  @map("expires_at")
  createdAt DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("sessions")
}

model Sector {
  id        String    @id @default(uuid())
  name      String    @unique
  status    String    @default("Activo")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  employees     Employee[]
  equipment     Equipment[]
  tickets       Ticket[]
  categories    TicketCategory[]
  posts         PostSector[]
  kbPermissions KbPermission[]

  @@map("sectors")
}

// Categorias de ticket POR SECTOR: cada sector que recibe pedidos define las
// suyas ("Hardware" para Sistemas, "Arreglar"/"Modificacion" para
// Mantenimiento, etc.). El Ticket guarda el NOMBRE como texto (snapshot):
// borrar una categoria no rompe los tickets historicos que la usaron.
model TicketCategory {
  id        String   @id @default(uuid())
  sectorId  String   @map("sector_id")
  name      String
  createdAt DateTime @default(now()) @map("created_at")

  sector Sector @relation(fields: [sectorId], references: [id], onDelete: Cascade)

  @@unique([sectorId, name])
  @@index([sectorId])
  @@map("ticket_categories")
}

model Schedule {
  id        String    @id @default(uuid())
  name      String    @unique
  startTime String    @map("start_time")
  endTime   String    @map("end_time")
  status    String    @default("Activo")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  tickets Ticket[]

  @@map("schedules")
}

model Employee {
  id           String    @id @default(uuid())
  code         String    @unique
  name         String
  document     String?
  email        String?
  phone        String?
  extension    String?
  sectorId     String?   @map("sector_id")
  position     String?
  status       String    @default("Activo")
  workShift    String?   @map("work_shift")
  // Horario laboral estructurado (HH:MM). Con estos dos campos la plataforma
  // puede calcular sola si la persona esta dentro de su horario ahora mismo,
  // en vez de depender de un texto libre que nadie puede interpretar.
  // Si workEndTime es menor que workStartTime, el turno cruza la medianoche
  // (por ejemplo 22:00–06:00) y el calculo lo contempla.
  workStartTime String?  @map("work_start_time")
  workEndTime   String?  @map("work_end_time")
  schedule     String?
  replacementId String?  @map("replacement_id")
  notes        String?
  changeLog    String?   @map("change_log")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")
  deletedAt    DateTime? @map("deleted_at")

  sector      Sector?    @relation(fields: [sectorId], references: [id], onDelete: SetNull)
  replacement Employee?  @relation("EmployeeReplacement", fields: [replacementId], references: [id], onDelete: SetNull)
  replacementOf Employee[] @relation("EmployeeReplacement")

  user                User?
  ticketsAsAffected   Ticket[]        @relation("TicketAffected")
  ticketsAsRequester  Ticket[]        @relation("TicketRequester")

  @@index([replacementId])
  @@index([sectorId])
  @@map("employees")
}

model Equipment {
  id        String    @id @default(uuid())
  code      String    @unique
  type      String
  model     String?
  status    String    @default("Activo")
  sectorId  String?   @map("sector_id")
  // Antes "notes"/Observaciones: renombrado a Cambios — historial automatico
  // de ediciones del equipo (la migracion renombra la columna, no pierde datos).
  changeLog String?   @map("change_log")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  sector Sector? @relation(fields: [sectorId], references: [id], onDelete: SetNull)

  tickets        Ticket[]
  logbookEntries LogbookEntry[]

  @@index([sectorId])
  @@map("equipment")
}

model Ticket {
  id            String    @id @default(uuid())
  code          String    @unique
  title         String
  description   String?
  employeeId    String    @map("employee_id")
  requestedById String?   @map("requested_by_id")
  equipmentId   String?   @map("equipment_id")
  sectorId      String?   @map("sector_id")
  scheduleId    String?   @map("schedule_id")
  category      String    @default("General")
  technicianId  String?   @map("technician_id")
  status        String    @default("Nuevo")
  priority      String    @default("Media")
  solution      String?
  timeSpent     String?   @map("time_spent")
  createdById   String?   @map("created_by_id")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")
  deletedAt     DateTime? @map("deleted_at")

  employee    Employee   @relation("TicketAffected", fields: [employeeId], references: [id])
  requestedBy Employee?  @relation("TicketRequester", fields: [requestedById], references: [id], onDelete: SetNull)
  equipment   Equipment? @relation(fields: [equipmentId], references: [id], onDelete: SetNull)
  sector      Sector?    @relation(fields: [sectorId], references: [id], onDelete: SetNull)
  schedule    Schedule?  @relation(fields: [scheduleId], references: [id], onDelete: SetNull)
  technician  User?      @relation("TicketTechnician", fields: [technicianId], references: [id], onDelete: SetNull)
  createdBy   User?      @relation("TicketCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)

  logbookEntries LogbookEntry[]
  attachments    Attachment[]

  @@index([employeeId])
  @@index([requestedById])
  @@index([equipmentId])
  @@index([sectorId])
  @@index([scheduleId])
  @@index([technicianId])
  @@index([createdById])
  @@index([status])
  @@map("tickets")
}

// Chat interno 1 a 1. Sin tabla de "grupos" (fuera de alcance por ahora).
// Conversation se crea recien con el primer mensaje (ver chat.service.ts),
// asi lastMessageAt nunca es null y el listado se ordena sin casos especiales.
// El par de usuarios se guarda canonico (userAId < userBId alfabeticamente)
// para que nunca existan dos conversaciones para el mismo par.
// Sin deletedAt: este alcance no incluye borrar ni editar mensajes.
model Conversation {
  id            String   @id @default(uuid())
  userAId       String   @map("user_a_id")
  userBId       String   @map("user_b_id")
  lastMessageAt DateTime @default(now()) @map("last_message_at")
  createdAt     DateTime @default(now()) @map("created_at")

  userA    User      @relation("ConversationUserA", fields: [userAId], references: [id], onDelete: Cascade)
  userB    User      @relation("ConversationUserB", fields: [userBId], references: [id], onDelete: Cascade)
  messages Message[]

  @@unique([userAId, userBId])
  @@index([userAId])
  @@index([userBId])
  @@map("chat_conversations")
}

// Un mensaje pertenece a una conversacion 1 a 1 (conversationId) O a un
// grupo (groupId) — exactamente uno de los dos, garantizado por el service.
model Message {
  id             String    @id @default(uuid())
  conversationId String?   @map("conversation_id")
  groupId        String?   @map("group_id")
  senderId       String    @map("sender_id")
  body           String
  createdAt      DateTime  @default(now()) @map("created_at")
  readAt         DateTime? @map("read_at")

  conversation Conversation? @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  group        ChatGroup?    @relation(fields: [groupId], references: [id], onDelete: Cascade)
  sender       User          @relation(fields: [senderId], references: [id], onDelete: Cascade)
  attachments  Attachment[]

  @@index([conversationId, createdAt])
  @@index([groupId, createdAt])
  @@index([senderId])
  @@map("chat_messages")
}

// Grupos de chat: los crea el Administrador y elige quienes participan.
// En los grupos el "leido" es por miembro (lastReadAt), no por mensaje.
model ChatGroup {
  id          String   @id @default(uuid())
  name        String
  createdById String?  @map("created_by_id")
  createdAt   DateTime @default(now()) @map("created_at")
  lastMessageAt DateTime @default(now()) @map("last_message_at")

  createdBy User?             @relation("ChatGroupCreator", fields: [createdById], references: [id], onDelete: SetNull)
  members   ChatGroupMember[]
  messages  Message[]

  @@index([createdById])
  @@map("chat_groups")
}

model ChatGroupMember {
  id         String    @id @default(uuid())
  groupId    String    @map("group_id")
  userId     String    @map("user_id")
  lastReadAt DateTime? @map("last_read_at")
  createdAt  DateTime  @default(now()) @map("created_at")

  group ChatGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  user  User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([groupId, userId])
  @@index([userId])
  @@map("chat_group_members")
}

// Archivos adjuntos (imagenes, PDF, Excel) de tickets y mensajes de chat.
// El archivo fisico vive en el volumen de uploads con un nombre aleatorio
// (storedName); aca solo los metadatos. Un adjunto pertenece a un ticket O a
// un mensaje; recien subido esta "suelto" (ambos null) hasta que el ticket o
// mensaje que lo referencia se crea. Los sueltos viejos se limpian solos.
model Attachment {
  id           String   @id @default(uuid())
  storedName   String   @unique @map("stored_name")
  originalName String   @map("original_name")
  mimeType     String   @map("mime_type")
  size         Int
  ticketId     String?  @map("ticket_id")
  messageId    String?  @map("message_id")
  postId       String?  @map("post_id")
  articleId    String?  @map("article_id")
  uploadedById String?  @map("uploaded_by_id")
  createdAt    DateTime @default(now()) @map("created_at")

  ticket     Ticket?    @relation(fields: [ticketId], references: [id], onDelete: SetNull)
  message    Message?   @relation(fields: [messageId], references: [id], onDelete: SetNull)
  post       Post?      @relation(fields: [postId], references: [id], onDelete: SetNull)
  article    KbArticle? @relation(fields: [articleId], references: [id], onDelete: SetNull)
  uploadedBy User?      @relation(fields: [uploadedById], references: [id], onDelete: SetNull)

  @@index([ticketId])
  @@index([messageId])
  @@index([postId])
  @@index([articleId])
  @@index([uploadedById])
  @@map("attachments")
}

// Notificaciones internas (campanita): las genera el backend ante eventos
// (ticket nuevo, cambio de estado, asignacion, alta en un grupo) y llevan a
// un destino dentro de la plataforma (targetType + targetId).
model Notification {
  id         String    @id @default(uuid())
  userId     String    @map("user_id")
  title      String
  targetType String    @map("target_type")
  targetId   String?   @map("target_id")
  readAt     DateTime? @map("read_at")
  createdAt  DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([userId, readAt])
  @@map("notifications")
}

model LogbookEntry {
  id                String    @id @default(uuid())
  code              String    @unique
  title             String
  category          String
  detail            String?
  authorId          String?   @map("author_id")
  relatedTicketId   String?   @map("related_ticket_id")
  relatedEquipmentId String?  @map("related_equipment_id")
  occurredAt        DateTime  @default(now()) @map("occurred_at")
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")
  deletedAt         DateTime? @map("deleted_at")

  author          User?      @relation(fields: [authorId], references: [id], onDelete: SetNull)
  relatedTicket   Ticket?    @relation(fields: [relatedTicketId], references: [id], onDelete: SetNull)
  relatedEquipment Equipment? @relation(fields: [relatedEquipmentId], references: [id], onDelete: SetNull)

  @@index([authorId])
  @@index([relatedTicketId])
  @@index([relatedEquipmentId])
  @@map("logbook_entries")
}

// ============================================================
// FEED DE NOVEDADES
// ============================================================
// Tablero interno donde Administradores y Supervisores publican novedades
// de la empresa (una noticia, la grilla de puestos del sabado, un aviso).
// Lo lee todo el personal segun a quien este dirigida cada publicacion.
//
// El contenido NO se guarda como HTML: se guarda como una lista de bloques
// con estructura conocida (ver PostBlock). El renderizado arma el HTML a
// partir de esos datos escapando cada texto, asi el contenido que escribe
// una persona nunca puede convertirse en marcado ejecutable.

model Post {
  id        String    @id @default(uuid())
  authorId  String?   @map("author_id")
  title     String
  // "todos" o "sectores": si es "sectores", los destinatarios estan en
  // PostSector. Se guarda explicito para no confundir "dirigida a nadie"
  // con "dirigida a todos".
  audience  String    @default("todos")
  pinned    Boolean   @default(false)
  viewCount Int       @default(0) @map("view_count")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  author User? @relation("PostAuthor", fields: [authorId], references: [id], onDelete: SetNull)

  blocks      PostBlock[]
  sectors     PostSector[]
  comments    PostComment[]
  reactions   PostReaction[]
  views       PostView[]
  attachments Attachment[]

  @@index([pinned, createdAt])
  @@index([authorId])
  @@map("posts")
}

// Un bloque de contenido. `kind` dice de que tipo es (titulo, texto, tabla,
// imagen, archivo, enlace, tarjeta, oculto) y `data` guarda sus campos ya
// validados por Zod contra el esquema de ESE tipo. Nunca HTML libre.
model PostBlock {
  id       String @id @default(uuid())
  postId   String @map("post_id")
  kind     String
  position Int
  data     Json

  post Post @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@index([postId, position])
  @@map("post_blocks")
}

// Destinatarios cuando la publicacion no es para todos.
model PostSector {
  id       String @id @default(uuid())
  postId   String @map("post_id")
  sectorId String @map("sector_id")

  post   Post   @relation(fields: [postId], references: [id], onDelete: Cascade)
  sector Sector @relation(fields: [sectorId], references: [id], onDelete: Cascade)

  @@unique([postId, sectorId])
  @@index([sectorId])
  @@map("post_sectors")
}

model PostComment {
  id        String    @id @default(uuid())
  postId    String    @map("post_id")
  authorId  String?   @map("author_id")
  body      String
  createdAt DateTime  @default(now()) @map("created_at")
  deletedAt DateTime? @map("deleted_at")

  post   Post  @relation(fields: [postId], references: [id], onDelete: Cascade)
  author User? @relation("PostCommentAuthor", fields: [authorId], references: [id], onDelete: SetNull)

  @@index([postId, createdAt])
  @@map("post_comments")
}

// Una reaccion por persona y publicacion (el "me gusta" del feed).
model PostReaction {
  id        String   @id @default(uuid())
  postId    String   @map("post_id")
  userId    String   @map("user_id")
  createdAt DateTime @default(now()) @map("created_at")

  post Post @relation(fields: [postId], references: [id], onDelete: Cascade)
  user User @relation("PostReactionUser", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([postId, userId])
  @@index([userId])
  @@map("post_reactions")
}

// Quien vio cada publicacion. Es una fila por persona (no un contador suelto)
// para poder mostrar "lo leyeron 42" y quienes son, sin inflarse con recargas.
model PostView {
  id       String   @id @default(uuid())
  postId   String   @map("post_id")
  userId   String   @map("user_id")
  viewedAt DateTime @default(now()) @map("viewed_at")

  post Post @relation(fields: [postId], references: [id], onDelete: Cascade)
  user User @relation("PostViewUser", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([postId, userId])
  @@index([userId])
  @@map("post_views")
}

// ============================================================
// BASES DE CONOCIMIENTO
// ============================================================
// Cada area arma la suya (Facturacion, Sistemas, RR.HH.). Adentro hay
// secciones y articulos, y cada articulo se compone de los mismos bloques
// que el feed. Quien crea la base -o un Administrador- decide que sectores,
// rangos o personas pueden leerla y quienes pueden editarla.

model KbSpace {
  id          String    @id @default(uuid())
  // Sin @unique a nivel de columna: la unicidad se aplica SOLO entre las
  // bases vivas, con un indice parcial creado en la migracion
  // (`WHERE deleted_at IS NULL`). Con un unique comun, borrar una base
  // dejaba su nombre ocupado para siempre y el aviso decia que ya existia
  // una base que el usuario no veia por ningun lado.
  name        String
  description String?
  icon        String?
  createdById String?   @map("created_by_id")
  status      String    @default("Activo")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  deletedAt   DateTime? @map("deleted_at")

  createdBy User? @relation("KbSpaceCreator", fields: [createdById], references: [id], onDelete: SetNull)

  sections    KbSection[]
  permissions KbPermission[]

  @@map("kb_spaces")
}

model KbSection {
  id       String @id @default(uuid())
  spaceId  String @map("space_id")
  name     String
  position Int    @default(0)

  space    KbSpace     @relation(fields: [spaceId], references: [id], onDelete: Cascade)
  articles KbArticle[]

  @@index([spaceId, position])
  @@map("kb_sections")
}

model KbArticle {
  id          String    @id @default(uuid())
  sectionId   String    @map("section_id")
  title       String
  position    Int       @default(0)
  updatedById String?   @map("updated_by_id")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  deletedAt   DateTime? @map("deleted_at")

  section   KbSection @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  updatedBy User?     @relation("KbArticleEditor", fields: [updatedById], references: [id], onDelete: SetNull)

  blocks      KbBlock[]
  attachments Attachment[]

  @@index([sectionId, position])
  @@map("kb_articles")
}

model KbBlock {
  id        String @id @default(uuid())
  articleId String @map("article_id")
  kind      String
  position  Int
  data      Json

  article KbArticle @relation(fields: [articleId], references: [id], onDelete: Cascade)

  @@index([articleId, position])
  @@map("kb_blocks")
}

// Un permiso apunta a UNA sola cosa: un sector, un rango o una persona.
// `level` es "lectura" o "edicion" (edicion implica lectura).
model KbPermission {
  id       String  @id @default(uuid())
  spaceId  String  @map("space_id")
  level    String
  sectorId String? @map("sector_id")
  role     String?
  userId   String? @map("user_id")

  space  KbSpace @relation(fields: [spaceId], references: [id], onDelete: Cascade)
  sector Sector? @relation(fields: [sectorId], references: [id], onDelete: Cascade)
  user   User?   @relation("KbPermissionUser", fields: [userId], references: [id], onDelete: Cascade)

  @@index([spaceId])
  @@index([sectorId])
  @@index([userId])
  @@map("kb_permissions")
}
