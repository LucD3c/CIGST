# ============================================================================
# CIGST — Configuración de entorno (.env)
# ============================================================================
# Copiá este archivo a ".env" (sin ".example") antes de levantar la
# plataforma. "docker compose up -d" lo lee automáticamente.
#
# NO HACE FALTA EDITAR ESTE ARCHIVO A MANO: install.sh / install.ps1 lo
# crean solos la primera vez y te preguntan por consola los 3 valores que de
# verdad importan (contraseña de administrador, contraseña de la base de
# datos, puerto), generando el resto con valores seguros por defecto. Esta
# guía es para quien quiera entender o ajustar cada variable a mano —
# por ejemplo, para adaptar la plataforma a la red de una empresa en
# particular.
#
# REGLA DE ORO: este archivo tiene contraseñas y NUNCA se sube a GitHub
# (está en .gitignore). Guardalo en un lugar seguro — quien lo tenga, tiene
# acceso administrativo a toda la plataforma.
# ============================================================================


# ─── Base de datos (PostgreSQL) ─────────────────────────────────────────────
# Este contenedor NO expone ningún puerto hacia afuera (ver docker-compose.yml):
# solo es alcanzable desde el propio backend, dentro de la red interna que
# arma Docker Compose. Aun así, estas credenciales protegen los datos si
# alguna vez se accede a la máquina donde corre la plataforma.

# Nombre de usuario interno de la base de datos. No es una cuenta de la
# plataforma (esa se crea con SEED_ADMIN_USERNAME más abajo) — es la cuenta
# técnica que usa el backend para conectarse a Postgres. El valor por
# defecto es seguro para dejar como está.
POSTGRES_USER=cigst

# ⚠️ CAMBIAR ANTES DE USAR EN PRODUCCIÓN. Contraseña de esa cuenta técnica.
# Recomendado: 20+ caracteres al azar (letras, números). El instalador la
# genera sola si apretás Enter en la pregunta correspondiente — no hace
# falta inventarla a mano. Evitá reutilizar una contraseña de otro sistema.
POSTGRES_PASSWORD=cambiar-esta-contrasena

# Nombre de la base de datos dentro de Postgres. El valor por defecto es
# seguro para dejar como está; solo tiene sentido cambiarlo si en la misma
# instancia de Postgres vas a alojar más de una base (no es el caso típico
# de esta plataforma, que usa un Postgres dedicado).
POSTGRES_DB=cigst


# ─── Backend / plataforma ───────────────────────────────────────────────────

# Puerto en el que la plataforma queda disponible dentro de la red interna,
# por ejemplo http://IP-DEL-SERVIDOR:APP_PORT. Cambialo solo si el 3000 ya
# está ocupado por otra cosa en esa máquina (el instalador te avisa si
# detecta el conflicto). No es un puerto "de seguridad": cualquier puerto
# alto (por ejemplo 8080, 3001) es igual de válido.
APP_PORT=3000

# Nombre de la cookie de sesión que usa el navegador. El valor por defecto
# es seguro para dejar como está; cambiarlo no mejora ni empeora la
# seguridad, solo tiene sentido si en la misma red conviven varias
# instancias de CIGST y querés distinguirlas.
SESSION_COOKIE_NAME=cigst_session

# Horas de validez de una sesión inactiva antes de pedir iniciar sesión de
# nuevo. Bajarlo (por ejemplo a 4) reduce la ventana de uso indebido si
# alguien deja una sesión abierta en un equipo compartido; subirlo mejora la
# comodidad en equipos personales. 12 es un balance razonable para una
# jornada laboral.
SESSION_TTL_HOURS=12

# 🔒 DECISIÓN DE SEGURIDAD IMPORTANTE. En true, la cookie de sesión solo
# viaja por HTTPS (el navegador se niega a mandarla por HTTP simple). Dejala
# en:
#   - false  → si la plataforma se sirve por HTTP simple dentro de la red
#              interna (sin certificado), que es el despliegue típico de
#              esta plataforma en una LAN de empresa. Es seguro en ese
#              contexto porque el tráfico nunca sale de la red interna.
#   - true   → SOLO si hay un proxy reverso (nginx, Caddy, etc.) delante del
#              backend sirviendo HTTPS con un certificado real. Ponerlo en
#              true sin HTTPS real rompe el login (la cookie nunca llega).
COOKIE_SECURE=false

# Poné en true ÚNICAMENTE si hay un proxy reverso delante del backend (nginx,
# Caddy, un load balancer). Cuando está en true, la plataforma confía en la
# cabecera X-Forwarded-For de ese proxy para saber la IP real de quien hace
# el pedido (usada por el límite de intentos de login). Dejarlo en true SIN
# un proxy real es un riesgo: cualquiera podría falsificar esa cabecera y
# evadir el límite de intentos de login. Si no sabés si tenés un proxy
# delante, dejalo en false.
TRUST_PROXY=false

# Nivel de detalle de los registros del servidor: fatal, error, warn, info,
# debug, trace o silent. "info" es el recomendado para uso normal (registra
# cada pedido HTTP sin ser demasiado verboso). Usá "debug" solo para
# diagnosticar un problema puntual — genera muchos más registros.
LOG_LEVEL=info

# Zona horaria de la empresa. Se usa para que las fechas y horas de los
# historiales de cambios (personas, equipos, usuarios) y los tickets se
# muestren correctas para quien las lee, no en UTC. Lista de valores
# válidos: https://en.wikipedia.org/wiki/List_of_tz_database_time_zones
TZ=America/Argentina/Buenos_Aires


# ─── Usuario administrador inicial ──────────────────────────────────────────
# Esta cuenta se crea UNA SOLA VEZ, la primera vez que la plataforma arranca
# con una base de datos vacía. Cambiar estos valores después de ese primer
# arranque NO cambia la cuenta ya creada — para eso hay que editarla desde
# el Panel administrador, dentro de la plataforma, una vez logueado.

# Usuario de la cuenta administradora inicial. "admin" es un valor razonable
# y no es, por sí solo, un riesgo de seguridad (lo que protege la cuenta es
# la contraseña, no el nombre de usuario).
SEED_ADMIN_USERNAME=admin

# ⚠️ CAMBIAR ANTES DE USAR EN PRODUCCIÓN — esta es la contraseña más
# importante de toda la instalación: esa cuenta tiene acceso total a la
# plataforma (crear/editar/eliminar usuarios, ver todo, administrar todo).
# Recomendado: 12+ caracteres, sin reutilizar de otro sistema. El instalador
# la genera sola (20 caracteres al azar) si apretás Enter en la pregunta
# correspondiente. Si la vas a elegir vos a mano, evitá palabras de
# diccionario y datos personales/de la empresa fáciles de adivinar.
SEED_ADMIN_PASSWORD=cambiar-esta-contrasena

# Clave con la que se cifran las contrasenas de las casillas de correo que se
# configuren en la plataforma (seccion Correo). El instalador la genera sola:
# NO hace falta tocarla.
#
# Sin esta clave, la seccion de Correo queda desactivada y el resto de la
# plataforma funciona igual. Se prefiere eso a usar una clave por defecto que
# cualquiera pueda leer en el codigo.
#
# Si la cambias o la perdes, las casillas ya configuradas dejan de funcionar y
# hay que volver a cargarles la contrasena. Tene presente que quien tenga este
# archivo Y una copia de la base puede descifrar esas contrasenas.
MAIL_ENCRYPTION_KEY=

# --- Rendimiento -------------------------------------------------------------
# Cuantas conexiones simultaneas a Postgres mantiene la plataforma. 30 cubre
# comodo unas 70 personas trabajando a la vez. Subirlo solo tiene sentido si
# tambien se sube max_connections de Postgres.
DB_POOL=30

# En que direccion de red escucha la plataforma.
#   0.0.0.0   -> toda la red local (uso normal en una empresa)
#   127.0.0.1 -> solo la propia maquina; se usa cuando hay un nginx adelante
APP_BIND=0.0.0.0

# --- Limpieza de datos sin uso -----------------------------------------------
# Solo alcanza a datos que ya no le sirven a nadie: avisos de la campanita ya
# leidos y avisos que nadie abrio nunca despues de mucho tiempo. NUNCA se
# borran tickets, mensajes, archivos adjuntos, personas, equipos ni articulos.
RETENTION_NOTIF_LEIDAS_DIAS=90
RETENTION_NOTIF_SIN_LEER_DIAS=365

# --- Espacio en disco --------------------------------------------------------
# Tope para la carpeta de archivos adjuntos, en gigabytes. Al llegar al tope se
# dejan de aceptar archivos NUEVOS; todo lo ya guardado sigue intacto y
# descargable.
UPLOADS_MAX_GB=20
# A partir de que porcentaje del tope se empieza a avisar en el registro.
UPLOADS_AVISO_PORCENTAJE=80
# Margen de espacio libre que se exige en el disco fisico, en megabytes.
DISCO_MINIMO_LIBRE_MB=1024

# --- Compresion de imagenes --------------------------------------------------
# Se aplica en el servidor a toda imagen que entra, venga del navegador o de un
# programa externo. Lado maximo en pixeles y calidad (0 a 1).
IMAGEN_MAX_LADO=1600
IMAGEN_CALIDAD=0.82
