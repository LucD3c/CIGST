# Copia este archivo a ".env" (sin .example) antes de levantar la plataforma.
# "docker compose up -d" lee este archivo automaticamente. No hace falta ningun
# otro paso manual.

# --- Base de datos (contenedor interno, no expuesto a la red) ---
POSTGRES_USER=cigst
POSTGRES_PASSWORD=cambiar-esta-contrasena
POSTGRES_DB=cigst

# --- Backend ---
# Puerto en el que la plataforma queda disponible dentro de la red interna,
# por ejemplo http://IP-DEL-SERVIDOR:APP_PORT
APP_PORT=3000

# Nombre del cookie de sesion.
SESSION_COOKIE_NAME=cigst_session
# Horas de validez de una sesion inactiva antes de pedir login de nuevo.
SESSION_TTL_HOURS=12

# En true, el cookie de sesion solo viaja por HTTPS. Si la plataforma se sirve
# por HTTP simple dentro de la red interna (sin certificado), poner en false;
# si hay un proxy/reverse-proxy interno con HTTPS delante, dejar en true.
COOKIE_SECURE=false
# Poner en true solo si hay un proxy reverso (nginx, etc.) delante del backend.
TRUST_PROXY=false

LOG_LEVEL=info

# Zona horaria de la empresa (para fechas legibles en historiales de cambios).
TZ=America/Argentina/Buenos_Aires

# --- Usuario administrador inicial (se crea una unica vez, en el primer arranque) ---
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_PASSWORD=cambiar-esta-contrasena
